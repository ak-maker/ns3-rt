{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug simple-sionna-example",
      "type": "cppdbg",
      "request": "launch",

      /* 👉 point to the file you just verified exists */
      "program": "${workspaceFolder}/build/src/sionna/examples/ns3-dev-simple-sionna-example-debug",

      "args": [],                          // add command-line args here if needed
      "cwd": "${workspaceFolder}",
      "miDebuggerPath": "/usr/bin/gdb",

      "preLaunchTask": "ns3 build simple-sionna-example",

      "externalConsole": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
